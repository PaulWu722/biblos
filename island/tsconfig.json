{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src", "config", "tests", "vite.config.ts"]
}
